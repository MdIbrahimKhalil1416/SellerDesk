# Only pom.xml, mvnw, .mvn/ and src/ are needed to build the image.
# Everything else is excluded: smaller build context and no local secrets in the image.

# Secrets / local config: never inside an image
.env
.env.*
!.env.example

# Build output and IDE files
target/
.idea/
*.iml
.vscode/
*.log

# Not needed for the build
Dockerfile
.dockerignore
.git
.gitattributes
.gitignore
HELP.md
