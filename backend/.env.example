# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored. Never commit real secrets.
#
# Format: KEY=value  (Java properties format)
# - No quotes around values (quotes would become part of the value).
# - A backslash (\) is an escape character; avoid it or write \\.

# MongoDB Atlas connection string. URL-encode special characters in the password
# (e.g. @ -> %40, : -> %3A, / -> %2F).
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/sellerdesk?retryWrites=true&w=majority&appName=SellerDesk

# Optional: MongoDB for integration tests, e.g. a separate Atlas database.
# The database name MUST end with "-test" (tests delete all data in it before every test).
# Leave empty to use Docker (Testcontainers) instead; without both, integration tests are skipped.
MONGODB_TEST_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/sellerdesk-test?retryWrites=true&w=majority&appName=SellerDesk

# HMAC key for signing JWTs: at least 32 random bytes, base64.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=<base64-random-secret-at-least-32-bytes>

# SMTP credentials (e.g. a Gmail address + Gmail "App password").
# May stay empty in dev until email sending is built.
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-password>
# Sender shown in emails (optional; default: SellerDesk <no-reply@sellerdesk.app>).
# With Gmail SMTP this should be the same Gmail address as MAIL_USERNAME.
MAIL_FROM=SellerDesk <smtp-username>

# URL the browser uses for the app (no trailing slash). The refresh endpoint only accepts this Origin.
# Optional in dev: defaults to the Vite dev server, http://localhost:5173. Required in prod.
# APP_URL=http://localhost:5173

# Product images (Cloudinary dashboard > API Keys > "API environment variable")
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Courier webhooks (docs/modules/COURIER.md §5): HMAC key the courier signs its webhooks with.
# At least 32 characters. Generate one with:  openssl rand -base64 48
# Optional in dev: without it every webhook is rejected (401) and the mock simulator sends none.
# Required in prod as soon as a courier is enabled.
COURIER_WEBHOOK_SECRET=<base64-random-secret-at-least-32-bytes>

# Optional: the pretend courier "MOCK" for development (default true; always off in prod).
# COURIER_MOCK_ENABLED=true
