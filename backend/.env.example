# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored. Never commit real secrets.
#
# Format: KEY=value  (Java properties format)
# - No quotes around values (quotes would become part of the value).
# - A backslash (\) is an escape character; avoid it or write \\.

# MongoDB Atlas connection string. URL-encode special characters in the password
# (e.g. @ -> %40, : -> %3A, / -> %2F).
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/sellerdesk?retryWrites=true&w=majority&appName=SellerDesk

# HMAC key for signing JWTs: at least 32 random bytes, base64.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=<base64-random-secret-at-least-32-bytes>

# SMTP credentials (e.g. a Gmail address + Gmail "App password").
# May stay empty in dev until email sending is built.
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-password>

# Frontend origin allowed by CORS (Vite dev server default).
FRONTEND_URL=http://localhost:5173
